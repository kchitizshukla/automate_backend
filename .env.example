# ──────────────────────────────────────────────
# AutoMate backend — environment reference
#
# Local dev: copy this to apps/backend/server/.env and fill in.
# Render:    set these in the dashboard (or via render.yaml). No .env needed.
# ──────────────────────────────────────────────

# One port for the whole service. Render injects PORT automatically.
BACKEND_PORT=4000

# PostgreSQL — the three modules use three separate databases.
# See docs/DEPLOYMENT.md for how to run these on a single free Postgres instance.
USER_DATABASE_URL=postgresql://postgres:password@localhost:5432/am_user
MECHANIC_DATABASE_URL=postgresql://postgres:password@localhost:5432/am_mech
ADMIN_DATABASE_URL=postgresql://postgres:password@localhost:5432/am_admin

# Keep small on free tiers — three pools share one process.
PG_POOL_MAX=5

# Auth. One secret shared by all three modules; each still checks its own role.
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Guards the internal user<->mechanic dispatch endpoints.
INTERNAL_DISPATCH_SECRET=change_me_in_production

# Comma-separated origins allowed to call the API (the four Vercel URLs).
# Leave EMPTY and CORS is open to everything — fine for dev, not for production.
CORS_ORIGINS=

# File uploads (ephemeral on Render free — see docs/DEPLOYMENT.md).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Roadside simulation knobs (optional; defaults are sensible).
# MECHANIC_RESPONSE_TIMEOUT=30000
# ETA_SIMULATION_SPEEDUP=1
# PAYMENT_SIMULATED_LATENCY_MS=800
# PAYMENT_SIMULATED_FAILURE_RATE=0

# USER_INTERNAL_API / MECHANIC_INTERNAL_API default to loopback on this process
# and need no configuration. Set them only if running the modules as separate
# services (npm run dev:user:split etc.).
